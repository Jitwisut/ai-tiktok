# Development-only shared secret for the legacy extension upload routes.
# These shared-token routes return 404 in production. Generate for local development with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EXTENSION_UPLOAD_TOKEN=""

# Comma-separated Better Auth user IDs allowed to manage /admin/licenses.
# Register your admin account first, then copy its exact user.id from PostgreSQL.
LICENSE_ADMIN_USER_IDS=""

