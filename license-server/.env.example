# Runtime: use the PostgreSQL provider's pooled connection URL with TLS.
DATABASE_URL="postgresql://USER:PASSWORD@POOL_HOST:5432/license_db?sslmode=require"
# Migrations/admin provisioning: use the direct connection to the SAME database.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/license_db?sslmode=require"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Exact user IDs printed by npm run admin:create, comma-separated.
LICENSE_ADMIN_USER_IDS=""
