{
  "manifest_version": 3,
  "name": "AI Affiliate Studio — Add to Studio",
  "version": "0.3.0",
  "description": "Standalone product-to-video studio: import products, analyze and script them with Gemini, then drive Google AI Studio/Flow to generate the clips — all from one side panel.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "sidePanel",
    "unlimitedStorage",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://aistudio.google.com/*",
    "https://flow.google.com/*"
  ],
  "action": {
    "default_title": "AI Affiliate Studio — เปิด side panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content-scraper.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "dist/panel.js",
        "dist/ai-studio-automation.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "dist/flow-file-picker.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "dist/panel.js",
        "dist/flow-automation.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/tiktokstudio/*"
      ],
      "js": [
        "dist/panel.js",
        "dist/tiktok-upload.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "dist/dev-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
